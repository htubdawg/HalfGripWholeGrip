    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <Compile Include="BindingChecks.cs" />
    <Reference Include="$(GameDir)/HalfGrip_Data/Managed/*.dll" Exclude="$(GameDir)/HalfGrip_Data/Managed/mscorlib.dll;$(GameDir)/HalfGrip_Data/Managed/netstandard.dll;$(GameDir)/HalfGrip_Data/Managed/System*.dll" />
    <Reference Include="$(GameDir)/BepInEx/core/*.dll" />
    <Reference Include="$(ModAssembly)" />
    <Reference Include="$(LoaderAssembly)" />
  </ItemGroup>
</Project>
